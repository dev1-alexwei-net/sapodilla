FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY ollama-mirror/go.mod ./
COPY ollama-mirror/src/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/usage-api .

FROM alpine:3.20
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder /out/usage-api /usr/local/bin/usage-api
USER app
# Default usage API port; override with ADDR at runtime.
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/usage-api"]
